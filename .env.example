# SYSTEMACT — variables de entorno
#
# Copia este archivo como `.env.local` y completa los valores.
# Encuentras estos datos en https://supabase.com/dashboard/project/<ref>/settings/api
#
# ⚠️  .env.local NO se sube al repo (está en .gitignore).
# ⚠️  Nunca pongas la `service_role_key` aquí — solo la `publishable` (también
#     conocida como `anon`). La service_role bypasea RLS y debe vivir solo en
#     variables de entorno del servidor (Vercel, etc.) si se llega a necesitar.

NEXT_PUBLIC_SUPABASE_URL=https://<tu-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<tu-publishable-key>
